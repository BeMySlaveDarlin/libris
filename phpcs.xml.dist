<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Yii2">
    <rule ref="vendor/yiisoft/yii2-coding-standards/Yii2"></rule>

    <!-- generate relative paths -->
    <arg name="basepath" value="."/>

    <!-- directories to check -->
    <file>src/assets</file>
    <file>src/commands</file>
    <file>config</file>
    <exclude-pattern>config/__autocomplete.php</exclude-pattern>
    <file>src/controllers</file>
    <file>src/jobs</file>
    <file>src/migrations</file>
    <file>src/models</file>
    <file>src/rbac</file>
    <file>src/services</file>
    <file>src/tests</file>
    <file>src/validators</file>
</ruleset>
